{
  "name": "zelux-dl",
  "version": "1.1.0",
  "description": "ZELUX-DL — Lightning-fast terminal file downloader",
  "main": "zelux.js",
  "bin": {
    "zelux-dl": "./zelux.js"
  },
  "scripts": {
    "start": "node zelux.js",
    "build": "npm run build:windows && npm run build:linux && npm run checksums",
    "build:windows": "pkg zelux.js -t node18-win-x64 -o dist/ZELUX-DL.exe && node scratch/set_exe_icon.js",
    "build:linux": "pkg zelux.js -t node18-linux-x64 -o dist/ZELUX-DL-linux",
    "checksums": "node scripts/generate-checksums.js",
    "sign:windows": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1",
    "check": "node --check zelux.js && node --check make-cookies.js && node --test",
    "test": "node --test"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "resedit": "^3.0.2"
  }
}
