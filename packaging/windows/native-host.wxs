<?xml version="1.0" encoding="utf-8"?>
<!-- Prism MSI fragment: browser native messaging registration + magnet: handler.
     Linked into Tauri's WiX template through bundle.windows.wix.fragmentPaths and
     componentRefs (PrismNativeHostRegistration). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PrismNativeHostRegistration" Guid="6B3E2B53-6C1F-4E59-9C2B-7F0E1B2A9D41">
        <RegistryKey Root="HKCU" Key="Software\Classes\magnet">
          <RegistryValue Type="string" Value="URL:Magnet link" KeyPath="yes" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Classes\magnet\DefaultIcon" Type="string" Value="[INSTALLDIR]ZeluxDL.exe,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\magnet\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]ZeluxDL.exe&quot; &quot;%1&quot;" />
      </Component>
    </DirectoryRef>

    <!-- Run as the installing user (Impersonate) so HKCU and %APPDATA% are the user's. -->
    <CustomAction Id="PrismRegisterHost" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]zeluxdl-native-host.exe&quot; register"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="PrismUnregisterHost" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]zeluxdl-native-host.exe&quot; unregister"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- The browser keeps prism-native-host.exe running while the extension is connected;
         stop it so the file can be replaced or removed (the extension reconnects by itself). -->
    <CustomAction Id="PrismStopHost" Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]taskkill.exe&quot; /F /IM zeluxdl-native-host.exe"
                  Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="PrismStopHost" Before="InstallValidate" />
      <Custom Action="PrismRegisterHost" Before="InstallFinalize">NOT REMOVE</Custom>
      <Custom Action="PrismUnregisterHost" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
