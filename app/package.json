{
  "name": "zeluxdl-app",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:sidecar": "node ../scripts/build-sidecar.mjs",
    "build:sidecar:debug": "node ../scripts/build-sidecar.mjs --debug",
    "tauri:build": "npm run build:sidecar && tauri build",
    "tauri:dev": "npm run build:sidecar:debug && tauri dev",
    "tauri:dev:test": "npm run build:sidecar:debug && node ../scripts/tauri-dev-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "2.12",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "~2.7",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-test-renderer": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
